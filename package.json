{
  "name": "vscode-starter-template",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.7.0",
  "publisher": "your-publisher",
  "license": "MIT",
  "icon": "media/icon.png",
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/taoweidong/vscode-starter-template.git"
  },
  "homepage": "https://github.com/taoweidong/vscode-starter-template#readme",
  "bugs": {
    "url": "https://github.com/taoweidong/vscode-starter-template/issues"
  },
  "keywords": [
    "crud",
    "starter",
    "template",
    "webview",
    "tree view",
    "context menu"
  ],
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=20.19.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "crudStarter",
          "title": "%viewsContainers.title%",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "crudStarter": [
        {
          "id": "crudStarter.envView",
          "name": "%view.env.name%"
        },
        {
          "id": "crudStarter.initView",
          "name": "%view.init.name%"
        },
        {
          "id": "crudStarter.buildView",
          "name": "%view.build.name%"
        },
        {
          "id": "crudStarter.serialServersView",
          "name": "%view.serialServers.name%"
        }
      ]
    },
    "commands": [
      {
        "command": "crudStarter.refreshEnvironment",
        "title": "%command.refreshEnvironment.title%",
        "category": "%command.category%",
        "icon": "$(refresh)"
      },
      {
        "command": "crudStarter.showEnvironmentOutput",
        "title": "%command.showEnvironmentOutput.title%",
        "category": "%command.category%",
        "icon": "$(output)"
      },
      {
        "command": "crudStarter.runAllInit",
        "title": "%command.runAllInit.title%",
        "category": "%command.category%",
        "icon": "$(checklist)"
      },
      {
        "command": "crudStarter.runInitStep",
        "title": "%command.runInitStep.title%",
        "category": "%command.category%",
        "icon": "$(play)"
      },
      {
        "command": "crudStarter.buildBranch",
        "title": "%command.buildBranch.title%",
        "category": "%command.category%",
        "icon": "$(package)"
      },
      {
        "command": "crudStarter.openGallery",
        "title": "%command.openGallery.title%",
        "category": "%command.category%",
        "icon": "$(library)"
      },
      {
        "command": "crudStarter.openSerialConsole",
        "title": "%command.openSerialConsole.title%",
        "category": "%command.category%",
        "icon": "$(terminal)"
      },
      {
        "command": "crudStarter.addSerialServer",
        "title": "%command.addSerialServer.title%",
        "category": "%command.category%",
        "icon": "$(add)"
      },
      {
        "command": "crudStarter.editSerialServer",
        "title": "%command.editSerialServer.title%",
        "category": "%command.category%"
      },
      {
        "command": "crudStarter.deleteSerialServer",
        "title": "%command.deleteSerialServer.title%",
        "category": "%command.category%"
      },
      {
        "command": "crudStarter.connectSerialServer",
        "title": "%command.connectSerialServer.title%",
        "category": "%command.category%",
        "icon": "$(plug)"
      },
      {
        "command": "crudStarter.refreshSerialServers",
        "title": "%command.refreshSerialServers.title%",
        "category": "%command.category%",
        "icon": "$(refresh)"
      },
      {
        "command": "crudStarter.draftSelection",
        "title": "%command.draftSelection.title%",
        "category": "%command.category%",
        "icon": "$(symbol-string)"
      },
      {
        "command": "crudStarter.appendDraftSelection",
        "title": "%command.appendDraftSelection.title%",
        "category": "%command.category%",
        "icon": "$(add)"
      },
      {
        "command": "crudStarter.draftFile",
        "title": "%command.draftFile.title%",
        "category": "%command.category%",
        "icon": "$(new-file)"
      },
      {
        "command": "crudStarter.draftFolder",
        "title": "%command.draftFolder.title%",
        "category": "%command.category%",
        "icon": "$(folder-library)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "crudStarter.refreshEnvironment",
          "when": "view == crudStarter.envView",
          "group": "navigation@1"
        },
        {
          "command": "crudStarter.showEnvironmentOutput",
          "when": "view == crudStarter.envView",
          "group": "navigation@2"
        },
        {
          "command": "crudStarter.runAllInit",
          "when": "view == crudStarter.initView",
          "group": "navigation@1"
        },
        {
          "command": "crudStarter.buildBranch",
          "when": "view == crudStarter.buildView",
          "group": "navigation@1"
        },
        {
          "command": "crudStarter.openSerialConsole",
          "when": "view == crudStarter.serialServersView",
          "group": "navigation@1"
        },
        {
          "command": "crudStarter.addSerialServer",
          "when": "view == crudStarter.serialServersView",
          "group": "navigation@2"
        },
        {
          "command": "crudStarter.refreshSerialServers",
          "when": "view == crudStarter.serialServersView",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "crudStarter.runInitStep",
          "when": "view == crudStarter.initView && viewItem == initStep",
          "group": "inline@1"
        },
        {
          "command": "crudStarter.buildBranch",
          "when": "view == crudStarter.buildView && viewItem == buildBranch",
          "group": "inline@1"
        },
        {
          "command": "crudStarter.connectSerialServer",
          "when": "view == crudStarter.serialServersView && viewItem == serialServer",
          "group": "inline@1"
        },
        {
          "command": "crudStarter.connectSerialServer",
          "when": "view == crudStarter.serialServersView && viewItem == serialServerConnected",
          "group": "1_serial@1"
        },
        {
          "command": "crudStarter.editSerialServer",
          "when": "view == crudStarter.serialServersView && viewItem == serialServer",
          "group": "1_serial@2"
        },
        {
          "command": "crudStarter.editSerialServer",
          "when": "view == crudStarter.serialServersView && viewItem == serialServerConnected",
          "group": "1_serial@2"
        },
        {
          "command": "crudStarter.deleteSerialServer",
          "when": "view == crudStarter.serialServersView && viewItem == serialServer",
          "group": "1_serial@3"
        },
        {
          "command": "crudStarter.deleteSerialServer",
          "when": "view == crudStarter.serialServersView && viewItem == serialServerConnected",
          "group": "1_serial@3"
        }
      ],
      "editor/context": [
        {
          "command": "crudStarter.draftSelection",
          "when": "editorTextFocus && editorHasSelection",
          "group": "9_starter@1"
        },
        {
          "command": "crudStarter.appendDraftSelection",
          "when": "editorTextFocus && editorHasSelection",
          "group": "9_starter@2"
        },
        {
          "command": "crudStarter.draftFile",
          "when": "editorIsOpen && !editorHasSelection",
          "group": "9_starter@3"
        },
        {
          "command": "crudStarter.draftFile",
          "when": "editorIsOpen && editorHasSelection",
          "group": "9_starter@4"
        }
      ],
      "explorer/context": [
        {
          "command": "crudStarter.draftFile",
          "when": "!explorerResourceIsFolder && !listMultiSelection",
          "group": "9_starter@1"
        },
        {
          "command": "crudStarter.draftFile",
          "when": "!explorerResourceIsFolder && listMultiSelection",
          "group": "9_starter@2"
        },
        {
          "command": "crudStarter.draftFolder",
          "when": "explorerResourceIsFolder",
          "group": "9_starter@3"
        }
      ],
      "editor/title": [
        {
          "command": "crudStarter.draftFile",
          "when": "editorIsOpen",
          "group": "navigation@5"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "crudStarter.runStartupTasks": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.runStartupTasks.description%"
        },
        "crudStarter.serialConsoleEnabled": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.serialConsoleEnabled.description%"
        }
      }
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited"
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run build:host && npm run build:webview",
    "watch": "tsx scripts/build-extension.ts --watch",
    "check-types": "tsc --noEmit && vue-tsc --noEmit -p tsconfig.webview.json",
    "build:host": "tsx scripts/build-extension.ts",
    "build:webview": "vite build",
    "package": "npm run check-types && npm run build:host && npm run build:webview",
    "package:vsix": "npm run package && vsce package",
    "compile-tests": "tsc -p . --outDir out",
    "pretest": "npm run compile-tests",
    "test": "node out/test/runTest.js",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gate": "tsx scripts/gate.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.85.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^4.0.0",
    "@vue/test-utils": "^2.5.1",
    "esbuild": "^0.25.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "mocha": "^10.7.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.7",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "serialport": "^12.0.0"
  }
}
